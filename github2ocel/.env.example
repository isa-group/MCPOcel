# github2ocel — Environment Configuration



# -----------------------------------------------------------------------------
# REQUIRED — GitHub Authentication & Repository
# -----------------------------------------------------------------------------

# Personal Access Token (classic) or Fine-Grained Token.
# Required scopes: repo (read), read:org (if private org repo)
GITHUB_TOKEN=

# Repository to extract (owner/repo)
GITHUB_OWNER=statuscompliance
GITHUB_REPO=status-backend


# -----------------------------------------------------------------------------
# EXTRACTION PROFILE
# Controls how much data is extracted. Affects API cost and runtime.
#
#   minimal  — issues, PRs, branches, tags, milestones, releases,
#              commits, deployments, workflow runs, discussions
#   standard — + reviews, timeline events, CI status checks  (recommended)
#   complete — + inline review comments, review threads (maximum detail)
# -----------------------------------------------------------------------------

EXTRACTION_PROFILE=standard


# -----------------------------------------------------------------------------
# TIME WINDOW
# Limit extraction to a date range to reduce API usage.
#
# EXTRACT_SINCE_DAYS: how many days back to start (leave unset = full history)
# EXTRACT_UNTIL_DAYS: how many days back to end   (default = 0, i.e. today)
#
# Example: last 90 days → EXTRACT_SINCE_DAYS=90 / EXTRACT_UNTIL_DAYS=0
# -----------------------------------------------------------------------------

# EXTRACT_SINCE_DAYS=90
# EXTRACT_UNTIL_DAYS=0


# -----------------------------------------------------------------------------
# OUTPUT
# -----------------------------------------------------------------------------

STORAGE_DIR=./storage


# -----------------------------------------------------------------------------
# LOGGING
# Available levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use INFO for production, DEBUG for development/troubleshooting.
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FILE=logs/github_extractor.log


# -----------------------------------------------------------------------------
# API PERFORMANCE
# Tune these if you hit rate limits or timeouts.
# -----------------------------------------------------------------------------

# Request timeout in seconds
API_TIMEOUT=30

# Retry configuration
MAX_RETRIES=5
RETRY_BACKOFF_MIN=2.0
RETRY_BACKOFF_MAX=60.0

# Max pages per paginated resource (leave unset = no limit)
GITHUB_MAX_PAGES=8

# Items per page — REST (max 100)
GITHUB_PER_PAGE=100

# Items per page — GraphQL (max 100, keep ≤50 to avoid timeouts)
GITHUB_GRAPHQL_PER_PAGE=50


# -----------------------------------------------------------------------------
# API ENDPOINTS (only change for GitHub Enterprise)
# -----------------------------------------------------------------------------

# GITHUB_API_URL=https://api.github.com
# GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# LOGGING CONFIGURATION
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use INFO for production, DEBUG for development/troubleshooting
LOG_LEVEL=INFO

# Where the log file will be stored
LOG_FILE=logs/github_extractor.log

 # minimal, standard, complete
EXTRACTION_PROFILE=complete

# API PERFORMANCE
API_TIMEOUT=30
MAX_RETRIES=5
RETRY_BACKOFF_MIN=2.0
RETRY_BACKOFF_MAX=60.0

GITHUB_MAX_PAGES=8
