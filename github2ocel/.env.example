GITHUB_TOKEN=
OUTPUT_FILE = "github.ocel.json"
REPO_OWNER = "statuscompliance"
REPO_NAME = "status-backend"
 
# LOGGING CONFIGURATION
# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use INFO for production, DEBUG for development/troubleshooting
LOG_LEVEL=INFO
 
# Where the log file will be stored
LOG_FILE=logs/github_extractor.log
 
# API PERFORMANCE
API_TIMEOUT=30
MAX_RETRIES=5
RETRY_BACKOFF_MIN=2.0
RETRY_BACKOFF_MAX=60.0
 
GITHUB_MAX_PAGES=8
